rules_version = '2';

// Pictures on handover notes and messages stay behind the same audience
// as the note or thread. Token download URLs are not used.
// The browser reads them with getBlob, so the bucket also needs storage.cors.json.
// Rules still require a signed-in account; the CORS list only lets that browser see the bytes.

service firebase.storage {
  match /b/{bucket}/o {
    function userDoc() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return firestore.get(userDoc()).data;
    }

    function passwordWindowOk() {
      return ('signIn' in userData() && (userData().signIn == 'google' || userData().signIn == 'email_otp'))
        || ('passwordExpiresAt' in userData()
            && userData().passwordExpiresAt is timestamp
            && userData().passwordExpiresAt > request.time);
    }

    function isActiveUser() {
      return request.auth != null
        && firestore.exists(userDoc())
        && userData().active == true
        && userData().otpVerified == true
        && passwordWindowOk();
    }

    function isAllowedImage() {
      return request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|heic|heif)');
    }

    function threadDoc(threadId) {
      return /databases/(default)/documents/threads/$(threadId);
    }

    function canReadDirectImage(threadId) {
      return isActiveUser()
        && threadId.matches('^direct_[A-Za-z0-9]+_[A-Za-z0-9]+$')
        && firestore.exists(threadDoc(threadId))
        && firestore.get(threadDoc(threadId)).data.type == 'direct'
        && (
          userData().role == 'super_admin'
          || userData().role == 'admin'
          || request.auth.uid in firestore.get(threadDoc(threadId)).data.participantIds
        );
    }

    match /handover/{uid}/{fileName} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && uid == request.auth.uid && isAllowedImage();
      allow update, delete: if false;
    }

    match /messages/group/{uid}/{fileName} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && uid == request.auth.uid && isAllowedImage();
      allow update, delete: if false;
    }

    match /messages/{threadId}/{uid}/{fileName} {
      allow read: if canReadDirectImage(threadId);
      allow create: if canReadDirectImage(threadId)
        && uid == request.auth.uid
        && request.auth.uid in firestore.get(threadDoc(threadId)).data.participantIds
        && isAllowedImage();
      allow update, delete: if false;
    }
  }
}
