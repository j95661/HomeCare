rules_version = '2';

// HomeCare access control.
// A signed-in token is not enough. The live user profile must be active,
// OTP-verified, and inside its password window. Revocation flips `active`
// to false, so an existing token fails these rules immediately.
// Clients cannot create accounts, change roles, or write the super-admin flag.
// The super admin is `protected: true` and role `super_admin`, and no client
// write can change that document except their own on-shift toggle.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function profileExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return profileExists()
        && me().active == true
        && me().otpVerified == true
        && me().passwordExpiresAt is timestamp
        && request.time < me().passwordExpiresAt;
    }

    function role() {
      return me().role;
    }

    function isSuperAdmin() {
      return isActiveUser() && role() == 'super_admin' && me().protected == true;
    }

    function isAdmin() {
      return isActiveUser() && (role() == 'super_admin' || role() == 'admin');
    }

    function isTeamLeadOrAbove() {
      return isActiveUser() && (
        role() == 'super_admin' || role() == 'admin' || role() == 'team_lead'
      );
    }

    function isTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function timesLookValid(times) {
      return times is list
        && times.size() >= 1
        && times.size() <= 6
        && isTime(times[0])
        && (times.size() < 2 || isTime(times[1]))
        && (times.size() < 3 || isTime(times[2]))
        && (times.size() < 4 || isTime(times[3]))
        && (times.size() < 5 || isTime(times[4]))
        && (times.size() < 6 || isTime(times[5]));
    }

    function validMedication(data) {
      return data.keys().hasOnly(['name', 'dose', 'frequency', 'times', 'careNotes', 'active', 'updatedBy', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.dose is string
        && data.dose.size() <= 80
        && data.frequency is string
        && data.frequency.size() > 0
        && data.frequency.size() <= 80
        && timesLookValid(data.times)
        && data.careNotes is string
        && data.careNotes.size() <= 2000
        && data.active is bool
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validShift(data) {
      return data.keys().hasOnly(['userId', 'userName', 'date', 'start', 'end', 'createdBy', 'updatedAt'])
        && data.userId is string
        && data.userId.size() > 0
        && data.userName is string
        && data.userName.size() > 0
        && data.userName.size() <= 80
        && isDate(data.date)
        && isTime(data.start)
        && isTime(data.end)
        && data.start < data.end
        && data.createdBy is string
        && data.updatedAt == request.time
        && exists(userPath(data.userId))
        && get(userPath(data.userId)).data.active == true;
    }

    function pairId(ids) {
      return ids[0] < ids[1]
        ? 'direct_' + ids[0] + '_' + ids[1]
        : 'direct_' + ids[1] + '_' + ids[0];
    }

    function validActivity(data) {
      return data.keys().hasOnly(['title', 'details', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.details is string
        && data.details.size() <= 2000
        && data.createdBy is string
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validGuide(data) {
      return data.keys().hasOnly(['title', 'summary', 'steps', 'updatedBy', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.summary is string
        && data.summary.size() <= 400
        && data.steps is list
        && data.steps.size() <= 30
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /settings/{id} {
      allow read: if isActiveUser() && id == 'app';
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isActiveUser();
      allow create, delete: if false;
      allow update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onShift'])
        && request.resource.data.onShift is bool;

      match /devices/{deviceId} {
        allow read: if isActiveUser() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /medications/{id} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && validMedication(request.resource.data);
      allow delete: if isAdmin();
    }

    match /medicationLogs/{id} {
      allow read: if isTeamLeadOrAbove()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /medicationSnoozes/{id} {
      allow read, write: if false;
    }

    match /reminderReceipts/{id} {
      allow read, write: if false;
    }

    match /shifts/{id} {
      allow read: if isActiveUser();
      allow create: if isTeamLeadOrAbove()
        && validShift(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeamLeadOrAbove()
        && validShift(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isTeamLeadOrAbove();
    }

    match /shiftRequests/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /handoverNotes/{id} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /activities/{id} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && validActivity(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isActiveUser()
        && validActivity(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /guides/{id} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && validGuide(request.resource.data);
      allow delete: if isAdmin();
    }

    match /groupThread/{docId} {
      allow read: if isActiveUser() && docId == 'main';
      allow create, delete: if false;
      allow update: if isActiveUser()
        && docId == 'main'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageText', 'lastMessageAt', 'lastSenderName', 'lastSenderId'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 140
        && request.resource.data.lastSenderName is string;

      match /messages/{messageId} {
        allow read: if isActiveUser() && docId == 'main';
        allow create: if isActiveUser()
          && docId == 'main'
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /threads/{threadId} {
      allow read: if isActiveUser()
        && resource.data.type == 'direct'
        && request.auth.uid in resource.data.participantIds;
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'type', 'participantIds', 'title', 'lastMessageText', 'lastMessageAt', 'lastSenderId', 'lastSenderName'
        ])
        && request.resource.data.type == 'direct'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] is string
        && request.resource.data.participantIds[1] is string
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && threadId == pairId(request.resource.data.participantIds)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.lastMessageText == ''
        && request.resource.data.lastSenderId == ''
        && request.resource.data.lastSenderName == ''
        && request.resource.data.lastMessageAt == request.time;
      allow update: if isActiveUser()
        && resource.data.type == 'direct'
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageText', 'lastMessageAt', 'lastSenderName', 'lastSenderId'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 140;
      allow delete: if false;

      match /messages/{messageId} {
        function threadData() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data;
        }
        allow read: if isActiveUser()
          && threadData().type == 'direct'
          && request.auth.uid in threadData().participantIds;
        allow create: if isActiveUser()
          && threadData().type == 'direct'
          && request.auth.uid in threadData().participantIds
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /private/{document=**} {
      allow read, write: if false;
    }
  }
}
