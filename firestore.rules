rules_version = '2';

// HomeCare access control.
// A signed-in token is not enough. The live user profile must be active
// and OTP-verified. Password accounts must also be inside the password
// window. Gmail and email-code accounts do not expire a password.
// Revocation flips `active` to false, so an existing token fails these
// rules immediately.
// Clients cannot create accounts, change roles, or write the super-admin flag.
// The super admin is `protected: true` and role `super_admin`, and no client
// write can change that document except their own shift status.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function profileExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function passwordWindowOk() {
      return me().signIn == 'google'
        || me().signIn == 'email_otp'
        || (me().passwordExpiresAt is timestamp && request.time < me().passwordExpiresAt);
    }

    function isActiveUser() {
      return profileExists()
        && me().active == true
        && me().otpVerified == true
        && passwordWindowOk();
    }

    function role() {
      return me().role;
    }

    function isSuperAdmin() {
      return isActiveUser() && role() == 'super_admin' && me().protected == true;
    }

    function isAdmin() {
      return isActiveUser() && (role() == 'super_admin' || role() == 'admin');
    }

    function isTeamLeadOrAbove() {
      return isActiveUser() && (
        role() == 'super_admin' || role() == 'admin' || role() == 'team_lead'
      );
    }

    function isCareStaff() {
      return isActiveUser() && (role() == 'team_lead' || role() == 'care_provider');
    }

    function ownShiftUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() > 0
        && changed.hasOnly(['onShift', 'shiftHold'])
        && (!changed.hasAny(['onShift']) || request.resource.data.onShift is bool)
        && (!changed.hasAny(['shiftHold']) || request.resource.data.shiftHold is bool);
    }

    function canMessageUser(uid) {
      let person = get(userPath(uid)).data;
      return exists(userPath(uid))
        && person.active == true
        && (!('enabled' in person) || person.enabled == true)
        && (!('awaitingGoogle' in person) || person.awaitingGoogle == false);
    }

    function isTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function timesLookValid(times) {
      return times is list
        && times.size() >= 1
        && times.size() <= 6
        && isTime(times[0])
        && (times.size() < 2 || isTime(times[1]))
        && (times.size() < 3 || isTime(times[2]))
        && (times.size() < 4 || isTime(times[3]))
        && (times.size() < 5 || isTime(times[4]))
        && (times.size() < 6 || isTime(times[5]));
    }

    function validMedication(data) {
      return data.keys().hasOnly(['name', 'dose', 'frequency', 'times', 'careNotes', 'active', 'updatedBy', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.dose is string
        && data.dose.size() <= 80
        && data.frequency is string
        && data.frequency.size() > 0
        && data.frequency.size() <= 80
        && timesLookValid(data.times)
        && data.careNotes is string
        && data.careNotes.size() <= 2000
        && data.active is bool
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validTemplate(data) {
      return data.keys().hasOnly(['userId', 'userName', 'weekday', 'start', 'end', 'effectiveFrom', 'effectiveUntil', 'createdBy', 'updatedAt'])
        && data.userId is string
        && data.userId.size() > 0
        && data.userName is string
        && data.userName.size() > 0
        && data.userName.size() <= 80
        && data.weekday is int
        && data.weekday >= 0
        && data.weekday <= 6
        && isTime(data.start)
        && isTime(data.end)
        && data.start < data.end
        && isDate(data.effectiveFrom)
        && (data.effectiveUntil == '' || (isDate(data.effectiveUntil) && data.effectiveFrom < data.effectiveUntil))
        && data.createdBy is string
        && data.updatedAt == request.time
        && exists(userPath(data.userId))
        && get(userPath(data.userId)).data.active == true;
    }

    function validShift(data) {
      return data.keys().hasOnly(['userId', 'userName', 'date', 'start', 'end', 'createdBy', 'updatedAt'])
        && data.userId is string
        && data.userId.size() > 0
        && data.userName is string
        && data.userName.size() > 0
        && data.userName.size() <= 80
        && isDate(data.date)
        && isTime(data.start)
        && isTime(data.end)
        && data.start < data.end
        && data.createdBy is string
        && data.updatedAt == request.time
        && exists(userPath(data.userId))
        && get(userPath(data.userId)).data.active == true;
    }

    function pairId(ids) {
      return ids[0] < ids[1]
        ? 'direct_' + ids[0] + '_' + ids[1]
        : 'direct_' + ids[1] + '_' + ids[0];
    }

    function validActivity(data) {
      return data.keys().hasOnly(['title', 'details', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.details is string
        && data.details.size() <= 2000
        && data.createdBy is string
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validGuide(data) {
      return data.keys().hasOnly(['title', 'summary', 'period', 'steps', 'updatedBy', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.summary is string
        && data.summary.size() <= 400
        && data.period in ['morning', 'afternoon', 'evening']
        && data.steps is list
        && data.steps.size() <= 30
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /settings/{id} {
      allow read: if isActiveUser() && id == 'app';
      allow write: if false;
    }

    match /invites/{emailId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isActiveUser();
      allow create, delete: if false;
      allow update: if isActiveUser()
        && request.auth.uid == uid
        && ownShiftUpdate();

      match /devices/{deviceId} {
        allow read: if isActiveUser() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /medications/{id} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && validMedication(request.resource.data);
      allow delete: if isAdmin();
    }

    match /medicationLogs/{id} {
      allow read: if isTeamLeadOrAbove()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /medicationSnoozes/{id} {
      allow read, write: if false;
    }

    match /reminderReceipts/{id} {
      allow read, write: if false;
    }

    match /shifts/{id} {
      allow read: if isActiveUser();
      allow create: if isTeamLeadOrAbove()
        && validShift(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeamLeadOrAbove()
        && validShift(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isTeamLeadOrAbove();
    }

    match /shiftTemplates/{id} {
      allow read: if isActiveUser();
      allow create: if isTeamLeadOrAbove()
        && validTemplate(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeamLeadOrAbove()
        && validTemplate(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isTeamLeadOrAbove();
    }

    match /shiftExceptions/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /shiftRequests/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    function ownedImage(path, folder) {
      return path is string
        && path.matches('^' + folder + request.auth.uid + '/[A-Za-z0-9._-]{1,80}$');
    }

    function validHandover(data) {
      let textOnly = data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt'])
        && data.body.size() > 0;
      let withImage = data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt', 'imagePath'])
        && ownedImage(data.imagePath, 'handover/');
      return data.body is string
        && data.body.size() <= 4000
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 80
        && data.createdAt == request.time
        && (textOnly || withImage);
    }

    function validChatMessage(data, imageFolder) {
      let keys = data.keys();
      let hasImage = keys.hasAny(['imagePath']);
      let hasNotice = keys.hasAny(['notice']);
      let allowed = keys.hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
        || keys.hasOnly(['senderId', 'senderName', 'text', 'createdAt', 'imagePath'])
        || keys.hasOnly(['senderId', 'senderName', 'text', 'createdAt', 'notice'])
        || keys.hasOnly(['senderId', 'senderName', 'text', 'createdAt', 'imagePath', 'notice']);
      let textOk = hasImage
        ? (data.text.size() == 0 || data.text.matches('.*\\S.*'))
        : (data.text.size() > 0 && data.text.matches('.*\\S.*'));
      let imageOk = !hasImage || ownedImage(data.imagePath, imageFolder);
      let noticeOk = !hasNotice || (data.notice is bool && (data.notice == false || isTeamLeadOrAbove()));
      return allowed
        && data.senderId == request.auth.uid
        && data.senderName is string
        && data.senderName.size() > 0
        && data.senderName.size() <= 80
        && data.text is string
        && data.text.size() <= 2000
        && data.createdAt == request.time
        && textOk
        && imageOk
        && noticeOk;
    }

    function careTeamPreviewUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let preview = changed.hasOnly(['lastMessageText', 'lastMessageAt', 'lastSenderName', 'lastSenderId']);
      let notice = isTeamLeadOrAbove()
        && changed.hasOnly([
          'lastMessageText', 'lastMessageAt', 'lastSenderName', 'lastSenderId',
          'noticeMessageId', 'noticeText', 'noticeSenderId', 'noticeSenderName', 'noticeImagePath', 'noticeAt'
        ])
        && request.resource.data.noticeSenderId == request.auth.uid
        && request.resource.data.noticeAt == request.time
        && request.resource.data.noticeMessageId is string
        && request.resource.data.noticeMessageId.size() > 0
        && request.resource.data.noticeMessageId.size() <= 128
        && request.resource.data.noticeText is string
        && request.resource.data.noticeText.size() <= 2000
        && request.resource.data.noticeSenderName is string
        && request.resource.data.noticeSenderName.size() > 0
        && request.resource.data.noticeSenderName.size() <= 80
        && request.resource.data.noticeImagePath is string
        && request.resource.data.noticeImagePath.size() <= 180
        && (
          request.resource.data.noticeImagePath == ''
          || ownedImage(request.resource.data.noticeImagePath, 'messages/group/')
        );
      return (preview || notice)
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 140
        && request.resource.data.lastSenderName is string;
    }

    match /handoverNotes/{id} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validHandover(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /activities/{id} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && validActivity(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isActiveUser()
        && validActivity(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /guides/{id} {
      allow read: if isActiveUser();
      allow create, update: if isTeamLeadOrAbove() && validGuide(request.resource.data);
      allow delete: if isAdmin();
    }

    match /groupThread/{docId} {
      allow read: if isActiveUser() && docId == 'main';
      allow create, delete: if false;
      allow update: if (isCareStaff() || isAdmin()) && docId == 'main' && careTeamPreviewUpdate();

      match /messages/{messageId} {
        allow read: if isActiveUser() && docId == 'main';
        allow create: if (isCareStaff() || isAdmin())
          && docId == 'main'
          && validChatMessage(request.resource.data, 'messages/group/');
        allow update, delete: if false;
      }

      match /noticeReads/{uid} {
        allow read: if isActiveUser() && (uid == request.auth.uid || isAdmin());
        allow create, update: if isActiveUser()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['noticeMessageId', 'readAt'])
          && request.resource.data.noticeMessageId is string
          && request.resource.data.noticeMessageId.size() > 0
          && request.resource.data.noticeMessageId.size() <= 128
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    match /threads/{threadId} {
      allow get: if isActiveUser() && (
        !exists(/databases/$(database)/documents/threads/$(threadId))
        || (resource.data.type == 'direct' && (isAdmin() || request.auth.uid in resource.data.participantIds))
      );
      allow list: if isActiveUser()
        && resource.data.type == 'direct'
        && (isAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'type', 'participantIds', 'title', 'lastMessageText', 'lastMessageAt', 'lastSenderId', 'lastSenderName'
        ])
        && request.resource.data.type == 'direct'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] is string
        && request.resource.data.participantIds[1] is string
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && canMessageUser(request.resource.data.participantIds[0])
        && canMessageUser(request.resource.data.participantIds[1])
        && threadId == pairId(request.resource.data.participantIds)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.lastMessageText == ''
        && request.resource.data.lastSenderId == ''
        && request.resource.data.lastSenderName == ''
        && request.resource.data.lastMessageAt == request.time;
      allow update: if isActiveUser()
        && resource.data.type == 'direct'
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageText', 'lastMessageAt', 'lastSenderName', 'lastSenderId'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 140;
      allow delete: if false;

      match /messages/{messageId} {
        function threadData() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data;
        }
        allow read: if isActiveUser()
          && threadData().type == 'direct'
          && (isAdmin() || request.auth.uid in threadData().participantIds);
        allow create: if isActiveUser()
          && threadData().type == 'direct'
          && request.auth.uid in threadData().participantIds
          && validChatMessage(request.resource.data, 'messages/' + threadId + '/');
        allow update, delete: if false;
      }
    }

    match /private/{document=**} {
      allow read, write: if false;
    }
  }
}
